<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <NUnit>
    <!-- Blazor Server keeps one circuit per tab; 2 workers is a safe default for a laptop. -->
    <NumberOfTestWorkers>2</NumberOfTestWorkers>
  </NUnit>
  <Playwright>
    <BrowserName>chromium</BrowserName>
    <ExpectTimeout>10000</ExpectTimeout>
    <LaunchOptions>
      <!-- Set to false to watch the browser (or pass Playwright.LaunchOptions.Headless=false after the double dash on the dotnet test command line). -->
      <Headless>true</Headless>
    </LaunchOptions>
  </Playwright>
</RunSettings>
